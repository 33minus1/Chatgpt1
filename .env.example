# Public browser configuration. Never place a Supabase service_role/secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional canonical production URL, for example:
VITE_SITE_URL=https://example.vercel.app

# Backward compatibility only; VITE_SUPABASE_PUBLISHABLE_KEY is preferred.
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY
